# Made-up values. The real ones go only into Vercel's and Supabase's own settings, never into this repository.

# The Supabase project the site talks to (the testing project on staging, the real one in production).
SUPABASE_URL=https://example-project.supabase.co
# The public key: safe in the page, limited by the database's own rules.
SUPABASE_ANON_KEY=made-up-public-key
# The service key: skips every rule. Server functions only, never the page, never a log.
SUPABASE_SERVICE_KEY=made-up-service-key
# The secret the scheduled job must send. A long random value, kept in Vercel and in Supabase Vault.
JOB_SECRET=made-up-long-random-secret
